{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taste-labs.local/contracts/onboarding-pack.schema.json",
  "title": "OnboardingPack",
  "description": "Quiz and recommendations produced by onboarding_research.py after Tavily grounds the learner's interests. Lives at artifacts/profiles/{slug}/onboarding-pack.json. The HTTP API strips correct_id before sending quiz questions to the browser.",
  "type": "object",
  "required": ["slug", "interests", "quiz", "recommendations", "research"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "minLength": 1 },
    "interests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "goal": { "type": "string" },
    "quiz": {
      "type": "object",
      "required": ["questions"],
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "prompt",
              "choices",
              "correct_id",
              "topic"
            ],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^q-[0-9]{2}$" },
              "prompt": { "type": "string", "minLength": 1 },
              "choices": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": ["id", "text"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": ["a", "b", "c", "d"]
                    },
                    "text": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "correct_id": {
                "type": "string",
                "enum": ["a", "b", "c", "d"]
              },
              "topic": { "type": "string", "minLength": 1 },
              "source_id": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "why", "level"],
        "additionalProperties": false,
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "level": {
            "type": "string",
            "enum": ["beginner", "intermediate", "advanced"]
          },
          "source_id": { "type": "string" }
        }
      }
    },
    "level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "quiz_score": {
      "type": "object",
      "required": ["correct", "total"],
      "additionalProperties": false,
      "properties": {
        "correct": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "accessed_at": { "type": "string" }
        }
      }
    },
    "research": {
      "type": "object",
      "required": ["provider", "mode", "credits", "calls"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["dry-run", "test", "live"] },
        "credits": { "type": "integer", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0 },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pass", "query"],
            "additionalProperties": false,
            "properties": {
              "pass": {
                "type": "string",
                "enum": ["interests", "level_quiz", "extract", "recommend"]
              },
              "query": { "type": "string" },
              "credits": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "style_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
