{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taste-labs.local/contracts/asset-manifest.schema.json",
  "title": "AssetManifest",
  "type": "object",
  "required": ["run_id", "lesson_script", "assets"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "lesson_script": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "object",
      "required": ["talking_head_intro", "slide_images", "voiceover"],
      "additionalProperties": false,
      "properties": {
        "talking_head_intro": { "$ref": "#/$defs/asset" },
        "talking_head_intro_audio": {
          "description": "fal-generated short intro voiceover clip. Its URL is the audio_url input to the veed/fabric-1.0 call that produces talking_head_intro. Present only when the lesson script has an intro.",
          "$ref": "#/$defs/asset"
        },
        "talking_head_avatar": {
          "description": "fal-generated presenter avatar image. Its URL is the image_url input to the veed/fabric-1.0 call that produces talking_head_intro. Present only when the lesson script has an intro.",
          "$ref": "#/$defs/asset"
        },
        "voiceover": { "$ref": "#/$defs/asset" },
        "slide_images": {
          "type": "array",
          "minItems": 5,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/slide_asset" }
        }
      }
    },
    "timings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_id", "start_seconds", "end_seconds"],
        "additionalProperties": false,
        "properties": {
          "slide_id": { "type": "string", "pattern": "^slide-[0-9]{2}$" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["path", "media_type", "provider"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "provider_job_id": { "type": "string" },
        "prompt": { "type": "string" },
        "metadata_path": { "type": "string" }
      }
    },
    "slide_asset": {
      "type": "object",
      "required": ["slide_id", "path", "media_type", "provider"],
      "additionalProperties": false,
      "properties": {
        "slide_id": { "type": "string", "pattern": "^slide-[0-9]{2}$" },
        "path": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "provider_job_id": { "type": "string" },
        "prompt": { "type": "string" },
        "metadata_path": { "type": "string" }
      }
    }
  }
}
