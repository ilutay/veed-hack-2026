{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taste-labs.local/contracts/lesson-script.schema.json",
  "title": "LessonScript",
  "type": "object",
  "required": ["topic", "title", "learning_objective", "audience", "duration_seconds", "slides", "next_video"],
  "additionalProperties": false,
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "learning_objective": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "duration_seconds": { "const": 15 },
    "style_notes": { "type": "array", "items": { "type": "string" } },
    "intro": {
      "description": "Optional presenter intro. The 15-second format normally omits it; the talking-head stage is skipped when absent.",
      "type": "object",
      "required": ["hook", "talking_head_script", "duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "hook": { "type": "string", "minLength": 1 },
        "talking_head_script": { "type": "string", "minLength": 1 },
        "duration_seconds": { "type": "integer", "minimum": 5, "maximum": 45 }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title", "narration", "visual_brief", "duration_seconds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^slide-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "key_points": { "type": "array", "items": { "type": "string" } },
          "narration": { "type": "string", "minLength": 1 },
          "visual_brief": { "type": "string", "minLength": 1 },
          "duration_seconds": { "type": "number", "minimum": 1, "maximum": 5 },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "next_video": {
      "description": "Interactive choice of follow-up directions shown at the end of the video.",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["label", "direction"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "enum": ["A", "B", "C"] },
          "direction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "accessed_at": { "type": "string" }
        }
      }
    }
  }
}
