{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taste-labs.local/contracts/research-brief.schema.json",
  "title": "ResearchBrief",
  "description": "Grounded knowledge for one lesson. Produced by the topic_research stage and consumed by research_script, which decides what the video actually says. Deliberately carries no narration, slide breakdown, visual brief, or duration - those belong to research_script.",
  "type": "object",
  "required": ["run_id", "topic", "concept", "facts", "sources", "strategy", "next_topics", "research"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "audience": {
      "description": "Who the explanation is for. Maps to lesson-script `audience`.",
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "description": "The single takeaway this lesson should land. Maps to lesson-script `learning_objective`.",
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "description": "Every claim the script may assert, each traceable to a source. A claim with no source_id must not reach narration.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "source_id", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^fact-[0-9]{2}$" },
          "claim": { "type": "string", "minLength": 1 },
          "source_id": {
            "description": "References sources[].id. Flows to lesson-script `slides[].source_ids`.",
            "type": "string",
            "minLength": 1
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "note": { "type": "string" }
        }
      }
    },
    "misconceptions": {
      "description": "What learners commonly get wrong here. Contrast-case and elaborative-interrogation strategies draw directly on these.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "strategy": {
      "description": "The pedagogy this topic wants, with the reasoning that selected it, so the choice is auditable rather than asserted.",
      "type": "object",
      "required": ["id", "rationale"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "retrieval-practice",
            "worked-to-faded-example",
            "concrete-to-abstract",
            "analogy-first",
            "contrast-cases",
            "elaborative-interrogation",
            "dual-coding"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "runner_up": { "type": "string" }
      }
    },
    "next_topics": {
      "description": "Real adjacent directions found during research, not invented labels. Maps to lesson-script `next_video[].direction`.",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["direction", "topic", "why"],
        "additionalProperties": false,
        "properties": {
          "direction": { "type": "string", "enum": ["deeper", "wider", "applied"] },
          "topic": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string" }
        }
      }
    },
    "sources": {
      "description": "Item shape is identical to lesson-script.schema.json `sources[]` so research_script can copy entries through verbatim.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "accessed_at": { "type": "string" }
        }
      }
    },
    "taste_hints": {
      "description": "Learner preferences derived from taste-profile.json, forwarded so downstream stages can honour them too.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pace": { "type": "number", "minimum": -1, "maximum": 1 },
        "depth": { "type": "number", "minimum": -1, "maximum": 1 },
        "concreteness": { "type": "number", "minimum": -1, "maximum": 1 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "research": {
      "description": "Provenance and cost of this brief. `mode` distinguishes a fixture-derived brief from a real one - never present a dry-run brief as researched.",
      "type": "object",
      "required": ["provider", "mode", "credits", "calls"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["dry-run", "test", "live"] },
        "credits": { "type": "integer", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0 },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pass", "query"],
            "additionalProperties": false,
            "properties": {
              "pass": {
                "type": "string",
                "enum": ["ground_facts", "strategy", "next_topics", "extract"]
              },
              "query": { "type": "string" },
              "credits": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "style_notes": {
      "description": "Explicit assumptions and gaps. Mirrors the lesson-script field of the same name - state uncertainty here rather than hiding it in a claim.",
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
