# Copy to .env.local and fill in real values. Never commit .env.local.
#   cp .env.example .env.local

# --- Run control -------------------------------------------------------------
# dry-run | test | live   (see codex/skills/educational-video-workflow/references/workflow-contract.md)
# dry-run needs no provider credentials at all.
WORKFLOW_MODE=dry-run

# --- Public demo access boundary ---------------------------------------------
# SHA-256 hex digest of the shared access code; never store the plaintext code.
GYM_ACCESS_CODE_SHA256=
# At least 32 random bytes, used only to sign short-lived HttpOnly cookies.
GYM_COOKIE_SECRET=

# --- fal.ai — media stages and the Pioneer Gym stimulus text receipt ---------
# https://fal.ai/dashboard/keys
FAL_KEY=

# --- Veed.io — talking_head_intro stage (video) -------------------------------
# No key here: the VEED Fabric MCP server authenticates by OAuth per developer,
# through your AI client's own login flow, not through this file. See
# "MCP servers" in AGENTS.md and .mcp.json / .codex/config.toml at repo root.

# --- Tavily — topic_research stage -------------------------------------------
# https://app.tavily.com  (free tier: 1000 credits/month, ~125 lessons)
# Auth header: Authorization: Bearer $TAVILY_API_KEY   (keys are prefixed tvly-)
TAVILY_API_KEY=

# --- Pioneer — text-only rep validation and learner-edge recommendation ------
# https://pioneer.ai/settings/api-keys
# Auth header: X-API-Key: $PIONEER_API_KEY
PIONEER_API_KEY=
# Pin one chat-capable decoder model from GET https://api.pioneer.ai/base-models
PIONEER_MODEL=

# --- Codex SDK — skill-driven curriculum authoring and orchestration ----------
# Used by the server-side @openai/codex-sdk runner. A local authenticated Codex
# install may work without this; hosted environments should set it explicitly.
CODEX_API_KEY=
CODEX_MODEL=

# --- Optional overrides ------------------------------------------------------
# FAL_BASE_URL=https://queue.fal.run
# FAL_TTS_VOICE=Friendly_Person
# FAL_TTS_EMOTION=happy
# FAL_TTS_LANGUAGE=en
# FAL_TTS_SPEED=1.2
# FAL_IMAGE_SIZE=landscape_16_9
# FAL_IMAGE_STEPS=8
# FAL_INTRO_SECONDS=5
# TAVILY_BASE_URL=https://api.tavily.com
# PIONEER_BASE_URL=https://api.pioneer.ai/v1
