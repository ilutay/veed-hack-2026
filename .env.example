# Copy to .env.local and fill in real values. Never commit .env.local.
#   cp .env.example .env.local

# --- Run control -------------------------------------------------------------
# dry-run | test | live   (see codex/skills/educational-video-workflow/references/workflow-contract.md)
# dry-run needs no provider credentials at all.
WORKFLOW_MODE=dry-run

# --- fal.ai — slide_images + voiceover_video stages --------------------------
# https://fal.ai/dashboard/keys
FAL_KEY=

# --- Veed.io — talking_head_intro stage --------------------------------------
# Leave blank until the talking-head stage runs in test/live.
VEED_API_KEY=

# --- Optional overrides ------------------------------------------------------
# FAL_BASE_URL=https://fal.run
# VEED_BASE_URL=https://api.veed.io
